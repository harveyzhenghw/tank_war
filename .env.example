# Optional: override the ICE servers used by Online Duel.
# The value must be a JSON array of RTCIceServer objects. Public STUN servers are used
# when this is unset. Add a TURN server to play across restrictive or symmetric NATs.
#
# VITE_PEER_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
